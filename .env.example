# Postgres de produção (ex.: Neon pela Vercel Marketplace). Sem esta variável, usa Postgres embutido em ./.data
DATABASE_URL=
# Administrador criado automaticamente no primeiro acesso, se ainda não houver usuários
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# Protege a rota do cron da Vercel (/api/cron/atualizar)
CRON_SECRET=
